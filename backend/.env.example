# ─── AI Research .env ───────────────────────────────
# Copy this file to .env and fill in your values.

# Your OpenRouter API key (required for AI features)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI model to use (defaults to openai/gpt-4o-mini if omitted)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Django secret key (change this in production!)
DJANGO_SECRET_KEY=ai-research-dev-secret-key-change-in-production
